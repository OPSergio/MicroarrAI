# =============================================================================
# .dockerignore
# =============================================================================
# Exclude unnecessary files from Docker build context for faster builds
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation (keep docs/ folder for in-app documentation)
*.md
!docs/**/*.md

# R specific
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# CI/CD
.github
.gitlab-ci.yml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Any local scratch data must never be sent as build context
data/

# Dev-only launcher, never part of an image
run_dev.R

# Built Singularity image
*.sif

# Cache
cache/
.cache/
