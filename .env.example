# =============================================================================
# MicroarrAI - Configuración de Entorno para Docker
# =============================================================================
# Copia este archivo a .env y personaliza los valores según tus necesidades
# =============================================================================

# ====================
# CONFIGURACIÓN DE RED
# ====================
# Puerto en el que la aplicación será accesible
SHINY_PORT=3838

# ====================
# RECURSOS DEL SISTEMA
# ====================
# Límites de CPU (número de cores)
CPU_LIMIT=4
CPU_RESERVATION=2

# Límites de memoria (en GB)
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G

# ====================
# CONFIGURACIÓN DE R
# ====================
# Nivel de logging (TRACE, DEBUG, INFO, WARN, ERROR)
SHINY_LOG_LEVEL=INFO

# Deshabilitar notación científica
R_SCIPEN=999

# Tamaño máximo de archivo de subida (en MB)
SHINY_MAX_UPLOAD_SIZE=100

# ====================
# SHINY SERVER
# ====================
# Timeout de inicialización de aplicación (segundos)
APP_INIT_TIMEOUT=60

# Timeout de inactividad (segundos)
APP_IDLE_TIMEOUT=3600

# ====================
# PERSISTENCIA
# ====================
# Directorio local para datos persistentes (comentar si no se necesita)
# DATA_DIR=./data

# Directorio local para logs
LOG_DIR=./logs

# Directorio local para resultados
# RESULTS_DIR=./results

# ====================
# SEGURIDAD
# ====================
# Habilitar autenticación (requiere configuración adicional)
# SHINY_AUTH_ENABLED=false

# ====================
# DESARROLLO
# ====================
# Modo desarrollo (recarga automática de archivos)
# DEV_MODE=false

# ====================
# NOTAS
# ====================
# - Después de modificar este archivo, reconstruye el contenedor:
#   docker-compose up -d --build
# 
# - Para aplicar solo cambios de variables de entorno (sin reconstruir):
#   docker-compose up -d
# ====================
