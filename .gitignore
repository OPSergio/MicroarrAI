# =============================================================================
# MicroarrAI - .gitignore
# =============================================================================

# R specific files
.Rhistory
.RData
.Rproj.user
.Ruserdata
*.Rproj

# R session data
.RDataTmp

# R package files
*.tar.gz
*.tgz
*.zip

# Documentation (keep docs/ in repo, but ignore certain build outputs)
# /docs  # Commented out - keep docs in repo
docs/**/*.html
docs/**/*.pdf

# =============================================================================
# Docker
# =============================================================================
# Don't commit the actual .env file (use .env.example instead)
.env

# Docker logs
logs/
*.log

# Docker volumes data
data/
results/
uploads/

# =============================================================================
# IDE and Editors
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# RStudio
*.Rproj.user/

# IntelliJ IDEA
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# =============================================================================
# OS Files
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# =============================================================================
# Temporary Files
# =============================================================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.cache

# =============================================================================
# Application Specific
# =============================================================================
# Shiny bookmarks (if enabled)
shiny_bookmarks/

# Uploaded user data
www/uploads/

# Generated plots
www/plots/

# Cache folders
cache/
.cache/

# Database files (if using SQLite)
*.db
*.sqlite
*.sqlite3

# Large data files (optional - uncomment if needed)
# *.csv
# *.xlsx
# *.rds
# *.rda

# =============================================================================
# CI/CD & Deployment
# =============================================================================
.github/workflows/*.log
.gitlab-ci.log

# =============================================================================
# Security
# =============================================================================
# API keys and secrets
.secrets
secrets.R
api_keys.R
credentials.R
