# =============================================================================
# MicroarrAI - Docker environment configuration
# =============================================================================
# Copy this file to docker/.env and edit it. Compose reads .env from the
# directory of the compose file, so it has to live next to docker-compose.yml,
# not at the repository root.
#
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up -d
#
# Every variable below is actually consumed by docker-compose.yml. If a variable
# is not listed here, it is not configurable this way.
# =============================================================================

# ====================
# NETWORK
# ====================
# Host port the application is published on (the container always listens on 3838)
SHINY_PORT=3838

# ====================
# SYSTEM RESOURCES
# ====================
CPU_LIMIT=4
CPU_RESERVATION=2
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G

# ====================
# APPLICATION
# ====================
# Log verbosity: TRACE, DEBUG, INFO, WARN, ERROR
SHINY_LOG_LEVEL=INFO

# Maximum size of a single upload, in MB. RAW mode uploads a whole scan set at
# once (one file per sample), so this must cover the batch, not one file.
MICROARRAI_MAX_UPLOAD_MB=1024

# =============================================================================
# NOTES
# =============================================================================
# - Changing these only needs a restart, not a rebuild:
#     docker compose -f docker/docker-compose.yml up -d
#
# - There is no data directory to configure: users upload their scan files
#   through the browser and those files live in the session's temporary
#   directory, which is deleted when the session ends.
# =============================================================================
