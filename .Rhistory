library(shiny)
library(shinyWidgets)
ui <- fluidPage(
titlePanel("Ejemplos mínimos de shinyWidgets::accordion()"),
h3("Ejemplo 1: Accordion básico"),
accordion(
accordionItem(
title = "Sección 1",
p("Este es el contenido de la sección 1")
),
accordionItem(
title = "Sección 2",
p("Este es el contenido de la sección 2")
),
open = FALSE   # todas cerradas por defecto
),
hr(),
h3("Ejemplo 2: Accordion con inputs y outputs"),
accordion(
accordionItem(
title = "Filtros",
sliderInput("n", "Número de puntos", min = 10, max = 200, value = 50)
),
accordionItem(
title = "Resultado",
plotOutput("plot")
),
open = 1   # abre la primera sección
)
)
library(shiny)
library(shinyWidgets)
ui <- fluidPage(
titlePanel("Ejemplos mínimos de shinyWidgets::accordion()"),
h3("Ejemplo 1: Accordion básico"),
accordion(
panel(
title = "Sección 1",
p("Este es el contenido de la sección 1")
),
panel(
title = "Sección 2",
p("Este es el contenido de la sección 2")
),
open = FALSE
),
hr(),
h3("Ejemplo 2: Accordion con inputs y outputs"),
accordion(
panel(
title = "Filtros",
sliderInput("n", "Número de puntos", min = 10, max = 200, value = 50)
),
panel(
title = "Resultado",
plotOutput("plot")
),
open = 1
)
)
server <- function(input, output, session) {
output$plot <- renderPlot({
plot(
rnorm(input$n),
main = paste("n =", input$n)
)
})
}
shinyApp(ui, server)
