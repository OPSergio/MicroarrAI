# Reanalisis Australia, basado en gamlss
# ---- Libraries ----
library(gamlss)
library(gamlss.dist)
library(dplyr)
library(tibble)
library(R.utils)
# ---- Sources (utilities) ----
devtools::install("C:/Users/solmo/Desktop/git/Perseo")
# ----- Load data -----
data <- readRDS("C:/Users/solmo/Downloads/Metadata.RDS")
# columnas clínicas vs péptidos (¡ojo a la coma!)
clinical_data <- data[, 1:14]
peptide_data  <- data[, 15:ncol(data)]
# Factores bien definidos
clinical_data$Status <- factor(ifelse(clinical_data$Status == "Persistent",
"Persistent", "Resolved"),
levels = c("Resolved","Persistent"))
clinical_data$sex <- factor(clinical_data$sex)
# (opcional) binariza síntomas si los usas luego
clinical_data <- clinical_data %>%
mutate(
Hives_bin    = ifelse(Hives == "Hives", 1, 0),
Vomiting_bin = ifelse(Vomiting == "Vomiting", 1, 0),
Angio_bin    = ifelse(angioedema_egg == "Angiodema", 1, 0)  # ojo a la ortografía en tus datos
)
# Índice de casos completos SOLO para las covariables que entran al diseño
vars_design <- c("Status","sex","Egg.SPT","histamine_average",
"Egg.White.RAST","Gal.d1.RAST","Gal.d2.RAST")
keep <- complete.cases(clinical_data[, vars_design])
# Subconjunta clínico + péptidos con el MISMO índice de sujetos
clinical_keep   <- clinical_data[keep, , drop = FALSE]
peptide_keep    <- peptide_data[keep, , drop = FALSE]
# Construye la design matrix (ya sin NAs)
design <- model.matrix(
~ Status + sex + Egg.SPT + histamine_average +
Egg.White.RAST + Gal.d1.RAST + Gal.d2.RAST,
data = clinical_keep
)
# Matriz de péptidos con orientación adecuada: péptidos x sujetos
counts_matrix_pep <- t(as.matrix(peptide_keep))
# Comprobaciones
cat("Sujetos totales:", nrow(clinical_data), "\n")
cat("Sujetos usados en diseño:", nrow(design), "\n")
cat("Sujetos en matriz de péptidos:", ncol(counts_matrix_pep), "\n")
stopifnot(nrow(design) == ncol(counts_matrix_pep))
# --- 0) Packages (needed by find_families' internals) ---
library(future)
library(future.apply)
plan(sequential)
# --- 2) Choose candidate families for this synthetic test ---
# (limit to the 4 you simulated; we can add NBI/TF later)
# --- 3) Run find_families with bootstrap pulls ---
set.seed(123)  # reproducibility
ff <- find_families(
counts_matrix   = counts_matrix_pep,
n_genes = 50,
n_boot = 5,
top_n = 4,
families = NULL,
verbose = TRUE,
min_n = 5,
seed = NULL,
group_by_support = FALSE,
binom_bd = NULL,
criterion = "BIC",
gaic_k = NULL,
filter_beta_inflated = TRUE,
thr_zero = 0.005,
thr_one = 0.005
)
remove.packages("PERSEO")
setwd("C:/Users/solmo/Desktop/git/MicroarrAI")
