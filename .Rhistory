# ---- Libraries ----
library(gamlss)
library(gamlss.dist)
library(dplyr)
library(tibble)
library(R.utils)
library(future)
library(future.apply)
# ---- Load PERSEO ----
#devtools::install("C:/Users/solmo/Desktop/git/Perseo")
#devtools::document("C:/Users/solmo/Desktop/git/Perseo")
devtools::load_all("C:/Users/solmo/Desktop/git/Perseo")
# ----- Load data -----
data <- readRDS("C:/Users/solmo/Downloads/Metadata.RDS")
clinical_data <- data[, 1:14]
peptide_data  <- data[, 15:ncol(data)]
# Mantener Status original (3 niveles)
clinical_data$Status <- factor(clinical_data$Status)
clinical_data$sex <- factor(clinical_data$sex)
clinical_data <- clinical_data %>%
mutate(
Hives_bin    = ifelse(Hives == "Hives", 1, 0),
Vomiting_bin = ifelse(Vomiting == "Vomiting", 1, 0),
Angio_bin    = ifelse(angioedema_egg == "Angiodema", 1, 0)
)
vars_design <- c(
"Status", "sex", "Egg.SPT", "histamine_average",
"Egg.White.RAST", "Gal.d1.RAST", "Gal.d2.RAST"
)
keep <- complete.cases(clinical_data[, vars_design])
clinical_keep <- clinical_data[keep, , drop = FALSE]
peptide_keep  <- peptide_data[keep, , drop = FALSE]
design <- model.matrix(
~ Status + sex + Egg.SPT + histamine_average +
Egg.White.RAST + Gal.d1.RAST + Gal.d2.RAST,
data = clinical_keep
)
counts_matrix_pep <- t(as.matrix(peptide_keep))
stopifnot(nrow(design) == ncol(counts_matrix_pep))
plan(sequential)
set.seed(123)
ff <- PERSEO::find_families(
counts_matrix   = counts_matrix_pep,
n_genes = 50,
n_boot  = 5,
top_n   = 4,
families = NULL,
verbose = TRUE,
min_n = 5,
group_by_support = FALSE,
criterion = "BIC",
filter_beta_inflated = TRUE,
thr_zero = 0.005,
thr_one  = 0.005
)
ff$top_families_overall
levels(clinical_keep$Status)
# e.g. "A" "B" "C"
contrast_matrix <- rbind(
"Resolved_vs_Persistent" = c(1,  0),
"Tolerant_vs_Persistent" = c(0,  1),
"Resolved_vs_Tolerant"   = c(1, -1)
)
colnames(contrast_matrix) <- c(
"StatusResolved",
"StatusTolerant"
)
plan(multisession, workers = max(1, availableCores() - 1))
fit_results <- PERSEO::fit_gamlss_models(
counts_matrix      = counts_matrix_pep,
design_matrix      = design,
candidate_families = "NO", #ff$top_families_overall
criterion          = "BIC",
min_n              = 5,
contrast_matrix    = contrast_matrix,
p_adjust           = "BH",
workers            = max(1, availableCores() - 1),
show_progress      = TRUE,
transform_mode     = "safe"
)
# Coeficientes clásicos
head(fit_results$results)
# Selección de familias
head(fit_results$selection)
# NUEVO: contrastes
head(fit_results$contrasts)
# ¿Cuántos contrastes por feature?
fit_results$contrasts %>%
count(feature)
library(ggplot2)
contrast_of_interest <- "Resolved_vs_Persistent"
volcano_df <- fit_results$contrasts %>%
filter(contrast == contrast_of_interest) %>%
mutate(
neglog10_p = -log10(p_adj),
sig = p_adj < 0.05
) %>%
filter(is.finite(neglog10_p), is.finite(estimate))
ggplot(volcano_df, aes(x = estimate, y = neglog10_p)) +
geom_point(aes(color = sig), alpha = 0.7) +
geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
labs(
title = paste("Volcano plot:", contrast_of_interest),
x = "Contrast effect (mu scale)",
y = expression(-log[10]("FDR"))
) +
theme_minimal()
contrast_of_interest <- "Tolerant_vs_Persistent"
volcano_df <- fit_results$contrasts %>%
filter(contrast == contrast_of_interest) %>%
mutate(
neglog10_p = -log10(p_adj),
sig = p_adj < 0.05
) %>%
filter(is.finite(neglog10_p), is.finite(estimate))
ggplot(volcano_df, aes(x = estimate, y = neglog10_p)) +
geom_point(aes(color = sig), alpha = 0.7) +
geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
labs(
title = paste("Volcano plot:", contrast_of_interest),
x = "Contrast effect (mu scale)",
y = expression(-log[10]("FDR"))
) +
theme_minimal()
contrast_of_interest <- "Resolved_vs_Tolerant"
volcano_df <- fit_results$contrasts %>%
filter(contrast == contrast_of_interest) %>%
mutate(
neglog10_p = -log10(p_adj),
sig = p_adj < 0.05
) %>%
filter(is.finite(neglog10_p), is.finite(estimate))
ggplot(volcano_df, aes(x = estimate, y = neglog10_p)) +
geom_point(aes(color = sig), alpha = 0.7) +
geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
labs(
title = paste("Volcano plot:", contrast_of_interest),
x = "Contrast effect (mu scale)",
y = expression(-log[10]("FDR"))
) +
theme_minimal()
