# =============================================================================
# MicroarrAI - Singularity/Apptainer Definition File
# =============================================================================
# Replicates exactly the same deployment as the Docker/docker-compose setup.
# Base: rocker/shiny-verse:4.4.0 (R 4.4.0, Shiny Server, tidyverse)
#
# The R package set is NOT duplicated here: it lives in dependencies.R at the
# repository root, which docker/Dockerfile installs the same way. Change the
# package list there and both images follow.
#
# BUILD (from repo root):
#   singularity build --fakeroot MicroarrAI.sif singularity/MicroarrAI.def
#   # or as root:
#   sudo singularity build MicroarrAI.sif singularity/MicroarrAI.def
#
# RUN (background instance):
#   mkdir -p logs tmp
#   singularity instance start \
#       --containall --no-home \
#       --bind ./logs:/var/log/shiny-server \
#       --bind ./tmp:/tmp \
#       MicroarrAI.sif microarrai
#   (--containall/--no-home keep the host's $HOME, /tmp and CWD out of the
#    container; ./tmp gives R a private on-disk /tmp for upload staging.
#    Don't use --writable-tmpfs: its 64 MB cap truncates uploads)
#
# ACCESS:
#   http://localhost:3838/MicroarrAI
# =============================================================================

Bootstrap: docker
From: rocker/shiny-verse:4.4.0

# =============================================================================
# METADATA
# =============================================================================
%labels
    Maintainer       MicroarrAI
    Version          1.0.0
    Description      Peptide microarray analysis platform with ML
    Base             rocker/shiny-verse:4.4.0
    Port             3838
    URL              http://localhost:3838/MicroarrAI

%help
    MicroarrAI - Peptide Microarray Analysis Platform
    ===================================================

    Build the image (from the repository root):
      singularity build --fakeroot MicroarrAI.sif singularity/MicroarrAI.def
      # or as root:
      sudo singularity build MicroarrAI.sif singularity/MicroarrAI.def

    Start in background:
      mkdir -p logs tmp
      singularity instance start \
          --containall --no-home \
          --bind ./logs:/var/log/shiny-server \
          --bind ./tmp:/tmp \
          MicroarrAI.sif microarrai

    Access the application:
      http://localhost:3838/MicroarrAI

    Loading your data:
      Users upload their scan files through the browser. They are staged in the
      session's tempdir and deleted when the session ends, so no user data is
      written into the image or onto the host.

    Stream logs:
      tail -f logs/*.log

    Stop the instance:
      singularity instance stop microarrai

    Open a shell inside the container:
      singularity shell --containall --no-home \
          --bind ./logs:/var/log/shiny-server \
          --bind ./tmp:/tmp MicroarrAI.sif

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
%environment
    export SHINY_LOG_LEVEL=INFO
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TZ=UTC
    # Upload ceiling for a whole scan set; see R/global.R
    export MICROARRAI_MAX_UPLOAD_MB=1024
    # No X display in the container: rgl must use its null device
    export RGL_USE_NULL=TRUE
    # Font cache for ggiraph/systemfonts: there is no $HOME in the container
    export XDG_CACHE_HOME=/tmp/.cache
    # Telemetry + admin accounts (bind-mounted from ./state by the deploy script)
    export MICROARRAI_STATE_DIR=/var/lib/microarrai

# =============================================================================
# APPLICATION FILES
# Copied to staging directory /opt/microarrai_src before %post.
# Not under /tmp: the build engine mounts a fresh /tmp during %post, which
# would hide files staged there.
# This ensures compatibility with all Singularity/Apptainer versions.
# Files are moved to their final destination during %post.
# =============================================================================
%files
    www             /opt/microarrai_src/www
    Def             /opt/microarrai_src/Def
    docs            /opt/microarrai_src/docs
    R               /opt/microarrai_src/R
    admin           /opt/microarrai_src/admin
    app.R           /opt/microarrai_src/app.R
    dependencies.R  /opt/microarrai_src/dependencies.R
    singularity/shiny-server-singularity.conf /opt/microarrai_src/shiny-server.conf

# =============================================================================
# BUILD STEPS
# Identical to the Dockerfile: same system dependencies, same R packages.
# =============================================================================
%post
    set -e

    # -------------------------------------------------------------------------
    # SYSTEM DEPENDENCIES (mirrors the Dockerfile)
    # -------------------------------------------------------------------------
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libcairo2-dev \
        libxt-dev \
        libx11-dev \
        libglu1-mesa-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libfontconfig1-dev \
        fontconfig \
        fonts-liberation \
        libharfbuzz-dev \
        libfribidi-dev \
        libglpk-dev \
        libgmp3-dev \
        libzip-dev \
        libpq-dev \
        libsqlite3-dev \
        zlib1g-dev \
        git \
        wget \
        curl \
    && rm -rf /var/lib/apt/lists/*

    # -------------------------------------------------------------------------
    # R PACKAGES
    # -------------------------------------------------------------------------
    # Single source of truth shared with docker/Dockerfile. No repos= override:
    # the rocker base pins CRAN to a dated Posit Package Manager snapshot, which
    # gives reproducible versions and prebuilt Linux binaries.
    Rscript /opt/microarrai_src/dependencies.R install

    # -------------------------------------------------------------------------
    # APPLICATION DEPLOYMENT
    # -------------------------------------------------------------------------

    # Clear default Shiny Server directory (mirrors the Dockerfile)
    rm -rf /srv/shiny-server/*

    # Create application directory
    mkdir -p /srv/shiny-server/MicroarrAI

    # Move files from staging area to final destination
    cp -r /opt/microarrai_src/www   /srv/shiny-server/MicroarrAI/www
    cp -r /opt/microarrai_src/Def   /srv/shiny-server/MicroarrAI/Def
    cp -r /opt/microarrai_src/docs  /srv/shiny-server/MicroarrAI/docs
    cp -r /opt/microarrai_src/R     /srv/shiny-server/MicroarrAI/R
    cp -r /opt/microarrai_src/admin /srv/shiny-server/MicroarrAI/admin
    cp    /opt/microarrai_src/app.R          /srv/shiny-server/MicroarrAI/app.R
    cp    /opt/microarrai_src/dependencies.R /srv/shiny-server/MicroarrAI/dependencies.R

    # Deploy Singularity-compatible Shiny Server configuration
    cp /opt/microarrai_src/shiny-server.conf /etc/shiny-server/shiny-server.conf

    # Clean up staging area
    rm -rf /opt/microarrai_src

    # -------------------------------------------------------------------------
    # PERMISSIONS
    # -------------------------------------------------------------------------
    mkdir -p /var/log/shiny-server /var/lib/microarrai
    chown -R shiny:shiny /srv/shiny-server/MicroarrAI
    chown -R shiny:shiny /var/log/shiny-server
    chmod -R 755 /srv/shiny-server/MicroarrAI

# =============================================================================
# ENTRYPOINT
# Equivalent to CMD ["/usr/bin/shiny-server"] in the Dockerfile
# =============================================================================

# Used with: singularity run MicroarrAI.sif
%runscript
    exec /usr/bin/shiny-server "$@"

# Used with: singularity instance start MicroarrAI.sif <name>
%startscript
    # Shiny Server's own log (worker crashes, proxy errors) goes next to the
    # app logs, so the admin panel and ./logs on the host can show it
    exec /usr/bin/shiny-server >> /var/log/shiny-server/shiny-server.log 2>&1

# =============================================================================
# POST-BUILD VERIFICATION
# Equivalent to a basic healthcheck
# =============================================================================
%test
    echo "=== Checking R packages ==="
    # Checks the full list in dependencies.R, not a hand-maintained subset
    Rscript /srv/shiny-server/MicroarrAI/dependencies.R check || exit 1

    echo "=== Checking application files ==="
    for f in app.R dependencies.R; do
        test -f /srv/shiny-server/MicroarrAI/$f \
            && echo "$f: OK" \
            || (echo "$f: MISSING" && exit 1)
    done
    for d in www Def docs R admin; do
        test -d /srv/shiny-server/MicroarrAI/$d \
            && echo "$d/: OK" \
            || (echo "$d/: MISSING" && exit 1)
    done

    echo "=== Checking the app parses ==="
    Rscript -e "invisible(parse('/srv/shiny-server/MicroarrAI/app.R'))" \
        && echo "app.R parses: OK" \
        || (echo "app.R FAILED to parse" && exit 1)

    Rscript -e "invisible(parse('/srv/shiny-server/MicroarrAI/admin/app.R'))" \
        && echo "admin/app.R parses: OK" \
        || (echo "admin/app.R FAILED to parse" && exit 1)

    echo "=== Checking Shiny Server configuration ==="
    test -f /etc/shiny-server/shiny-server.conf \
        && echo "shiny-server.conf: OK" \
        || (echo "shiny-server.conf: MISSING" && exit 1)

    echo "=== All checks passed ==="
